# ---------------------------------------------------------------------------
# Python / 构建缓存
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.uv/

# ---------------------------------------------------------------------------
# 编辑器 / IDE / 操作系统
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ---------------------------------------------------------------------------
# 沙箱 / 项目内部状态 / 本地工具（禁止提交）
# .codegraph 是指向本机绝对路径的符号链接，绝不能提交。
# ---------------------------------------------------------------------------
.omo/
.codegraph
.claude/

# ---------------------------------------------------------------------------
# 运行产物：日志与报告（保留 .gitkeep 占位）
# ---------------------------------------------------------------------------
logs/*.log
logs/*.jsonl
reports/raw/**/*
reports/html/**/*
reports/analysis/**/*
!reports/raw/.gitkeep
!reports/html/.gitkeep
!reports/analysis/.gitkeep

# ---------------------------------------------------------------------------
# 测试数据：默认不提交真实业务数据（保留 data/examples/ 与脱敏示例）
#
# 本项目遵循「脚本只描述行为，数据从 data/ 读取」的约定。
# 提交到仓库的数据文件应使用脱敏示例（见 data/examples/），
# 真实压测数据请放在本目录之外或交由 CI/本地生成，禁止入库。
# ---------------------------------------------------------------------------
data/*.txt
data/*.json
data/*.csv
!data/examples/
!data/examples/**
!data/.gitkeep
!data/README.md